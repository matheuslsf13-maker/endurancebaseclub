+      <ClassificationTable race={race} cls={cls} showLegs={race.legs.length > 1} linkAthletes="admin" athletesById={index.athletesById} />
+
+      <PodiumView cls={cls} athletesById={index.athletesById} />
+    </div>
+  );
+}
