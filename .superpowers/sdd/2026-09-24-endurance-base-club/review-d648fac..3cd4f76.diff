+
+    await act(() => router.navigate('/eventos/ev1/provas'));
+    await act(() => vi.advanceTimersByTimeAsync(14_000));
+    expect(live).toHaveBeenCalledTimes(calls);
+    expect(getEvent).toHaveBeenCalledTimes(1);
